# =============================================================================
# Vision Service — Environment Variables
# =============================================================================
# Sao chép file này thành .env rồi điền giá trị thực:
#   cp .env.example .env
#
# File .env ĐÃ ĐƯỢC liệt kê trong .gitignore — KHÔNG commit lên git!
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Notifications
# -----------------------------------------------------------------------------
# Lấy bot token từ https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Lấy chat_id bằng cách:
#   1. Gửi 1 tin nhắn bất kỳ tới bot của bạn
#   2. Mở trình duyệt: https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Tìm trường "chat" -> "id" trong response JSON
#   Nếu gửi vào group: thêm bot vào group, lấy id từ getUpdates (số âm, ví dụ: -1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here

# -----------------------------------------------------------------------------
# App Settings (tùy chọn — ghi đè app.yaml)
# -----------------------------------------------------------------------------
# APP_NAME=uit-medseg-vision
# APP_ENV=production
# LOG_LEVEL=INFO
# GPU_ID=0
